#!/usr/bin/env bash
# pick — randomly select a method tuple from the ideonomy catalog
#
# Usage:
#   bin/pick                    # default: 2 operators, 1 organon, 3 dim-prompts, ~50% recipe
#   bin/pick --more             # bigger tuple: 3 operators, 2 organons, 5 dim-prompts, 1 recipe
#   bin/pick --less             # smaller: 1 operator, 1 organon, 2 dim-prompts, 0 recipes
#   bin/pick --print            # only print the picks; don't cat the bodies
#   bin/pick --random-org       # seed the picker from random.org (network)
#   bin/pick --seed N           # deterministic pick for a given seed (no mtime side-effects)
#
# Silent behavior (no flags): each picked file is `touch`ed at the end. The
# picker weights against recently-touched files (1-hour half-life), so the
# catalog rotates naturally within a session — a method picked five minutes
# ago is much less likely to be picked again. --seed mode skips the touch
# so reproducibility is preserved.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
METHODS="$ROOT/methods"
HALF_LIFE=3600   # 1 hour, in seconds

OPS_N=2
ORG_N=1
DIM_N=3
REC_CHANCE=50    # percent chance to include a recipe in default mode
PRINT_ONLY=0
SEED=""
SOURCE="local"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --print)       PRINT_ONLY=1; shift ;;
    --random-org)  SOURCE="random.org"; shift ;;
    --seed)        SEED="${2:-}"; shift 2 ;;
    --more)        OPS_N=3; ORG_N=2; DIM_N=5; REC_CHANCE=100; shift ;;
    --less)        OPS_N=1; ORG_N=1; DIM_N=2; REC_CHANCE=0;   shift ;;
    -h|--help)
      sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "Unknown arg: $1" >&2
      exit 2
      ;;
  esac
done

# Seed the bash RNG.
if [[ -n "$SEED" ]]; then
  RANDOM=$SEED
elif [[ "$SOURCE" == "random.org" ]]; then
  ENTROPY=$(curl -fsS --max-time 5 \
    "https://www.random.org/integers/?num=1&min=0&max=32767&col=1&base=10&format=plain&rnd=new" \
    2>/dev/null || true)
  if [[ -n "${ENTROPY:-}" && "$ENTROPY" =~ ^[0-9]+$ ]]; then
    RANDOM=$ENTROPY
  else
    echo "warning: random.org request failed, falling back to local entropy" >&2
    RANDOM=$(( $(date +%s) ^ $$ ))
  fi
else
  RANDOM=$(( $(date +%s) ^ $$ ))
fi

# Detect stat flavor (BSD/macOS vs GNU/Linux).
if stat -f %m / >/dev/null 2>&1; then
  STAT_MTIME=( -f %m )
else
  STAT_MTIME=( -c %Y )
fi
NOW=$(date +%s)

# pick_n DIR N SEED — echo N files (one per line), weighted against recency.
# Searches recursively under DIR (so methods/recipes/learned/ is included
# when learned recipes accumulate). Skips README.md and files starting "_".
# Under --seed, weighting is disabled so picks stay reproducible.
pick_n() {
  local dir="$1" n="$2" seed="$3"
  if [[ ! -d "$dir" ]]; then return; fi
  local weight_enabled=1
  [[ -n "$SEED" ]] && weight_enabled=0
  find "$dir" -type f -name '*.md' ! -name 'README.md' ! -name '_*' 2>/dev/null \
    | sort \
    | while read -r f; do
        m=$(stat "${STAT_MTIME[@]}" "$f" 2>/dev/null || echo 0)
        printf '%s\t%s\n' "$m" "$f"
      done \
    | awk -v seed="$seed" -v now="$NOW" -v half="$HALF_LIFE" -v weighted="$weight_enabled" '
        BEGIN { srand(seed) }
        {
          mtime = $1
          file  = $2
          if (weighted) {
            age   = now - mtime
            if (age < 0) age = 0
            penalty = exp(-age / half)   # ~1 just-touched, ~0 long-cold
            score   = rand() + penalty   # bigger = less likely to be picked
          } else {
            score = rand()               # pure rand under --seed
          }
          print score "\t" file
        }
      ' \
    | sort -k1,1n \
    | head -"$n" \
    | cut -f2-
}

# Pre-evaluate $RANDOM in the parent shell. In bash 3.2, $RANDOM inside a
# command substitution's args is evaluated in the *subshell's* RNG, which has
# its own (non-deterministic) seed — so reproducibility under --seed only
# works if we capture the seeds here first.
SEED_OPS=$RANDOM
SEED_ORGS=$RANDOM
SEED_DIMS=$RANDOM
SEED_REC_COIN=$RANDOM
SEED_RECS=$RANDOM

OPS=$(pick_n  "$METHODS/operators"          "$OPS_N" "$SEED_OPS")
ORGS=$(pick_n "$METHODS/organons"           "$ORG_N" "$SEED_ORGS")
DIMS=$(pick_n "$METHODS/dimension-prompts"  "$DIM_N" "$SEED_DIMS")

RECS=""
if (( SEED_REC_COIN % 100 < REC_CHANCE )); then
  RECS=$(pick_n "$METHODS/recipes" 1 "$SEED_RECS")
fi

# --- Header ---
printf '=== IDEONOMY METHOD TUPLE (this invocation) ===\n\n'

print_block() {
  local label="$1" files="$2"
  [[ -z "$files" ]] && return
  printf '%s:\n' "$label"
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    name=$(basename "$f" .md)
    printf '  - %s\n' "$name"
  done <<< "$files"
  printf '\n'
}

print_block "OPERATORS"         "$OPS"
print_block "ORGANONS"          "$ORGS"
print_block "DIMENSION-PROMPTS" "$DIMS"
print_block "RECIPE"            "$RECS"

# --- Overlap callout: when a recipe is picked, parse its `<!-- uses: ... -->`
# metadata, intersect with the picked operators, and call out which picked
# operators the recipe already covers vs. which the agent must apply *in
# addition* to the recipe. The recipe is a second-pass overlay, never a
# substitute for the picked operators.
if [[ -n "$RECS" ]]; then
  recipe_file="$RECS"
  recipe_name=$(basename "$recipe_file" .md)
  uses_line=$(grep -E '^<!-- uses:' "$recipe_file" 2>/dev/null | head -1 || true)

  if [[ -n "$uses_line" ]]; then
    # Strip "<!-- uses:" prefix and "-->" suffix; split on commas.
    uses_raw=${uses_line#<!-- uses:}
    uses_raw=${uses_raw%-->}
    # Normalize: lowercase, trim spaces around items.
    recipe_ops=()
    IFS=',' read -ra _ru <<< "$uses_raw"
    for item in "${_ru[@]}"; do
      item="${item// /}"
      [[ -n "$item" ]] && recipe_ops+=("$item")
    done

    # Picked operator slugs.
    picked_ops=()
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      picked_ops+=("$(basename "$f" .md)")
    done <<< "$OPS"

    overlap=()
    extras=()
    for p in "${picked_ops[@]}"; do
      hit=0
      for r in "${recipe_ops[@]}"; do
        [[ "$p" == "$r" ]] && hit=1 && break
      done
      if (( hit )); then overlap+=("$p"); else extras+=("$p"); fi
    done

    printf '\n'
    printf '%s\n' '--- TUPLE COMPOSITION NOTE ---'
    printf 'The recipe `%s` chains: %s\n' "$recipe_name" "${recipe_ops[*]}"
    if (( ${#overlap[@]} > 0 )); then
      printf 'Overlap with your picked operators: %s\n' "${overlap[*]}"
      printf '  → applying the recipe covers these; do not double-count.\n'
    else
      printf 'Overlap with your picked operators: (none)\n'
    fi
    if (( ${#extras[@]} > 0 )); then
      printf 'REQUIRED EXTRAS (must be visibly applied IN ADDITION to the recipe): %s\n' "${extras[*]}"
    else
      printf 'No required-extras: every picked operator is covered by the recipe.\n'
      printf '  → you must still apply the dim-prompts and organon as their own phases;\n'
      printf '    the recipe is a Phase D overlay, not a replacement for Phases A–C.\n'
    fi
    printf 'The recipe is a Phase D overlay applied AFTER Phases A (dim-prompts), B (operators), C (organon). Never a substitute.\n'
    printf '%s\n' '------------------------------'
  fi
fi

printf '==============================================\n'

# --- Bodies ---
if (( ! PRINT_ONLY )); then
  cat_files() {
    local files="$1"
    [[ -z "$files" ]] && return
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      printf '\n----- %s -----\n' "$f"
      cat "$f"
    done <<< "$files"
  }

  cat_files "$OPS"
  cat_files "$ORGS"
  cat_files "$DIMS"
  cat_files "$RECS"
fi

# --- mtime memory: touch the picked files so they cool off in future picks.
# Skipped under --seed for reproducible picks during testing/demo.
if [[ -z "$SEED" ]]; then
  for f in $OPS $ORGS $DIMS $RECS; do
    [[ -n "$f" ]] && touch -- "$f" 2>/dev/null || true
  done
fi
